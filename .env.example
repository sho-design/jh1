# Copy to .env.local for local dev. In production, set these in Vercel > Project > Settings > Environment Variables.

# Stripe (test keys first). Without this, checkout runs in demo mode.
STRIPE_SECRET_KEY=
# Public site URL used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (added automatically by the Vercel Marketplace integration)
DATABASE_URL=
